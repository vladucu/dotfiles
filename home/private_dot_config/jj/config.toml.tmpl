[user]
# Identity used for commit metadata.
name = "Vlad Vanca"
email = "vanca.vlad@gmail.com"

[template-aliases]
# Render commit/change IDs as the shortest unique prefix.
'format_short_id(id)' = 'id.shortest()'
# Render timestamps as relative time, e.g. "2 hours ago".
"format_timestamp(timestamp)" = "timestamp.ago()"

{{- $gpgPath := or (lookPath "/opt/homebrew/bin/gpg") (lookPath "/usr/local/bin/gpg") }}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") $gpgPath }}
[signing]
# Sign commits you create when GPG is available on Apple Silicon macOS.
behavior = "own"
backend = "gpg"
key = "{{ .gpg_recipient }}"
{{- end }}

[aliases]
# Bookmark shortcuts.
b = ["bookmark"]
bl = ["bookmark", "list"]
bs = ["bookmark", "set"]
bt = ["bookmark", "track"]
bu = ["bookmark", "untrack"]

# Core jj shortcuts.
l = ["log"]
s = ["split"]
sq = ["squash"]
ab = ["abandon"]
u = ["undo"]
e = ["edit"]
sh = ["show"]
c = ["commit"]

# Git interop shortcuts.
gf = ["git", "fetch"]
gp = ["git", "push"]
gpa = ["git", "push", "--allow-new"]

# Start a new change from remote main.
nm = ["new", "main@origin"]
# Reset local main bookmark to remote main.
bmm = ["bookmark", "move", "main", "--to", "main@origin"]
# Move a bookmark from grandparent to parent; useful after committing from @.
bmb = ["bookmark", "move", "--from", "@--", "--to", "@-"]
# Show my 100 most recent changes (bounded; bare ::mine() scanned all ~41k commits -> ~6s).
lm = ["log", "-r", "my()"]
# Show my commits not yet merged into trunk (main@origin).
lu = ["log", "-r", "unmerged()"]

# Move the nearest ancestor bookmark to the latest committed change.
tug = ["bookmark", "move", "--from", "closest_bookmark(@-)", "--to", "@-"]

# Rebase the current branch/stack onto trunk().
retrunk = ["rebase", "-b", "@", "-d", "trunk()"]

# Rebase ALL my mutable stacks onto trunk() (immutable_heads().. excludes tags/untracked remote branches, which can't be rewritten).
retrunk-all = ["rebase", "-s", "roots(mine() & immutable_heads()..)", "-d", "trunk()"]

# Fetch remote changes, then rebase the current branch/stack onto trunk().
sync = ["util", "exec", "--", "sh", "-c", "jj git fetch && jj retrunk"]

[revsets]
# Default log: current change, nearby immutable heads, trunk; hide bot noise.
log = "(present(@) | ancestors(immutable_heads().., 2) | present(trunk())) & ~author(substring:'smile-ci-service@users.noreply.github.com') & ~author(substring:'[bot]@users.noreply.github.com')"
# Prefer short IDs for revisions between main and @.
short-prefixes = "(main..@)::"

[revset-aliases]
# All ancestors authored by me.
'mine_changes()' = '::mine()'
# Range from parents to @.
'to_parent()' = '..@'
# Range from @ forward.
'from_parent()' = '@..'
# Nearest bookmarked ancestor of a revision.
"closest_bookmark(to)" = "heads(::to & bookmarks())"
# Commits from the fork point of two revsets up to @.
"fork_history(to, from)" = "fork_point(to | from)..@"
# My recent work: current change plus my 100 latest changes (bounded for speed).
'my()' = 'present(@) | latest(mine(), 100)'
# My commits not yet in trunk (main@origin).
'unmerged()' = 'mine() & trunk()..'

[ui]
# Use scm-diff-editor for interactive split/squash/diff editing.
diff-editor = "scm-diff-editor"
# Running bare `jj` opens the log.
default-command = "log"
# Treat revset string patterns as globs by default; avoids future warnings.
revsets-use-glob-by-default = true
# jj's in-process pager (fast). hunk's interactive TTY startup was ~5s/command; use `jj diff | hunk pager` for diff review.
pager = ":builtin"
diff-formatter = ":git"

[merge-tools.scm-diff-editor]
# External diff editor command and arguments.
program = "scm-diff-editor"
edit-args = ["--dir-diff", "$left", "$right"]

# Agents (Claude Code, Pi, Codex) run jj without a terminal. An editor there
# hangs until the tool times out, so a missing -m or an interactive split
# fails at once instead. See agent-config docs/audits/actions.md row 5.
[[--scope]]
--when.environments = ["CLAUDECODE", "PI_SESSION_ID", "CODEX_THREAD_ID"]
[--scope.ui]
editor = "false"
diff-editor = "false"
merge-editor = "false"
