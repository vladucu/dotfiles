[user]
name = "Vlad Vanca"
email = "vanca.vlad@gmail.com"

[template-aliases]
# https://github.com/martinvonz/jj/blob/main/docs/config.md#display-of-commit-and-change-ids
# Just the shortest possible unique prefix
'format_short_id(id)' = 'id.shortest()'
"format_timestamp(timestamp)" = "timestamp.ago()"
# Prioritize the current branch to get shorter prefixes for certain revisions
# revsets.short-prefixes = "(main..@)::"

{{- $gpgPath := or (lookPath "/opt/homebrew/bin/gpg") (lookPath "/usr/local/bin/gpg") }}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") $gpgPath }}
[signing]
behavior = "own"
backend = "gpg"
key = "{{ .gpg_recipient }}"
{{- end }}

[aliases]
# Bookmark operations 
b = ["bookmark"]
bl = ["bookmark", "list"]
bs = ["bookmark", "set"]
bt = ["bookmark", "track"]
bu = ["bookmark", "untrack"]

# Core commands 
l = ["log"]
s = ["split"]
sq = ["squash"]
ab = ["abandon"]
u = ["undo"]
e = ["edit"]
sh = ["show"]
c = ["commit"]

# Git operations
gf = ["git", "fetch"]
gp = ["git", "push"]
gpa = ["git", "push", "--allow-new"]

# Workflow aliases
nm = ["new", "main@origin"]
bmm = ["bookmark", "move", "main", "--to", "main@origin"]
bmb = ["bookmark", "move", "--from", "@--", "--to", "@-"]
lm = ["log", "-r", "::mine()"]

[revsets]
# Overwrite the default to exclude noisy work service commits
# https://github.com/jj-vcs/jj/blob/main/cli/src/config/revsets.toml#L10C1-L10C74
log = "(present(@) | ancestors(immutable_heads().., 2) | present(trunk())) & ~ author('substring:smile-ci-service@users.noreply.github.com') & ~ author('substring:[bot]@users.noreply.github.com')"
my = "(present(@) | ::mine()) & ~ author('substring:smile-ci-service@users.noreply.github.com') & ~ author('substring:[bot]@users.noreply.github.com')"
short-prefixes = "(main..@)::"

[revset-aliases]
# Common revision ranges
'mine_changes()' = '::mine()'
'to_parent()' = '..@'
'from_parent()' = '@..'

[ui]
# diff-editor = ":builtin"
# Explicitly set the diff editor to the default one to fix bug with splitting not including deleted files
diff-editor = "scm-diff-editor"
default-command = "log"

# Suppress revset pattern syntax warnings for email addresses in author()
# This enables the new glob-by-default behavior to avoid future breaking changes
revsets-use-glob-by-default = true

[merge-tools.scm-diff-editor]
program = "scm-diff-editor"
edit-args = ["--dir-diff", "$left", "$right"]
