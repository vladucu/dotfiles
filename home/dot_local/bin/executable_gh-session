#!/bin/bash
# Passthrough to gh CLI.
#
# Previously this ran gh commands in a persistent tmux session ("github-ops")
# to keep 1Password biometric auth alive. That's no longer needed because:
#   - GITHUB_TOKEN is set from macOS Keychain at shell startup (env.zsh)
#   - Keychain is seeded by `sync-secrets` (1Password → Keychain, ~25ms)
#   - The `op plugin run -- gh` alias has been disabled
#
# This wrapper remains for backward compatibility — many agent configs,
# skills, and prompts reference `gh-session`. They can be gradually
# updated to use `gh` directly.
exec gh "$@"
