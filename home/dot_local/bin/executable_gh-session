#!/bin/bash
# Run gh commands in a persistent tmux session to keep 1Password auth alive

SESSION_NAME="github-ops"
OUTPUT_FILE="/tmp/gh-output-$RANDOM-$$"
EXITCODE_FILE="/tmp/gh-exitcode-$RANDOM-$$"

# Create session if it doesn't exist, force it to use bash
if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    tmux new-session -d -s "$SESSION_NAME" bash
fi

# Build the command with proper quoting
# Use bash printf %q to properly escape each argument
ESCAPED_ARGS=""
for arg in "$@"; do
    ESCAPED_ARGS+=" $(printf %q "$arg")"
done

CMD="gh${ESCAPED_ARGS} > $OUTPUT_FILE 2>&1; echo \$? > $EXITCODE_FILE"

# Send command to tmux session
tmux send-keys -t "$SESSION_NAME" "$CMD" C-m

# Wait for completion
timeout=50
while [[ $timeout -gt 0 ]]; do
    if [[ -f "$EXITCODE_FILE" ]]; then
        break
    fi
    sleep 0.2
    ((timeout--))
done

# Print output
if [[ -f "$OUTPUT_FILE" ]]; then
    cat "$OUTPUT_FILE"
fi

# Get exit code
exit_code=1
if [[ -f "$EXITCODE_FILE" ]]; then
    exit_code=$(cat "$EXITCODE_FILE")
fi

# Cleanup
rm -f "$OUTPUT_FILE" "$EXITCODE_FILE"

exit $exit_code
