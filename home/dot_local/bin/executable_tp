#!/usr/bin/env zsh
# tp - fuzzy-pick a tmux session with fzf
#
# Usage: tp
#   Lists all tmux sessions and lets you pick one with fzf.
#   If inside tmux, switches client. If outside, attaches.

if ! tmux list-sessions &>/dev/null; then
  echo "No tmux sessions running." >&2
  exit 1
fi

session=$(tmux list-sessions -F '#{session_name}' | fzf --height 40% --reverse --prompt="tmux session> ")

[ -z "$session" ] && exit 0

if [ -n "$TMUX" ]; then
  tmux switch-client -t "=$session"
else
  tmux attach-session -t "=$session"
fi
