#!/usr/bin/env zsh
# tm - create or attach to a tmux session named after the current directory
#
# Usage: tm [session-name]
#   If no argument given, uses the basename of the current directory.
#   Creates the session if it doesn't exist, then attaches/switches.

session_name="${1:-$(basename "$PWD")}"
# Replace dots with underscores (tmux doesn't like dots in session names)
session_name="${session_name//./_}"

if [ -n "$TMUX" ]; then
  # Already inside tmux — switch to the session
  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -d -s "$session_name" -c "$PWD"
  fi
  tmux switch-client -t "=$session_name"
else
  # Outside tmux — attach or create
  if tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux attach-session -t "=$session_name"
  else
    tmux new-session -s "$session_name" -c "$PWD"
  fi
fi
