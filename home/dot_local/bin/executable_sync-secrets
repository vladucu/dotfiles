#!/bin/bash
# Sync secrets from 1Password into macOS Keychain for fast shell startup.
#
# Keychain reads are ~25ms vs ~3s per `op read` call.
# Run this after 1Password login or when rotating secrets:
#   sync-secrets
#
# Secrets are stored in Keychain under account "dotfiles".
# Shell startup (env.zsh) and direnv (.envrc) read from Keychain.

set -euo pipefail

ACCOUNT="44TQRXVOJ5CR3BULYTHWSHDLAI"
KEYCHAIN_ACCOUNT="dotfiles"

# name:op_reference pairs (one per line)
SECRETS="
GITHUB_TOKEN|op://Personal/GITHUB_TOKEN PAT/token
OPENAI_API_KEY|op://Employee/OpenAI API Key/api key
GOOGLE_GENERATIVE_AI_API_KEY|op://Employee/GOOGLE_GENERATIVE_AI_API_KEY/credential
LINEAR_API_KEY|op://Employee/LINEAR_API_TOKEN/credential
PERCY_TOKEN|op://Employee/PERCY_TOKEN/token
HF_TOKEN|op://Employee/HF_TOKEN/token
"

echo "Syncing secrets from 1Password → macOS Keychain..."
echo ""

errors=0
while IFS='|' read -r name ref; do
  [ -z "$name" ] && continue
  printf "  %-35s " "$name"

  if value=$(op read "$ref" --account "$ACCOUNT" 2>/dev/null); then
    # Delete existing entry (ignore error if not found), then add new one
    security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$name" 2>/dev/null || true
    security add-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$name" -w "$value" 2>/dev/null
    echo "✓"
  else
    echo "✗ (failed to read from 1Password)"
    errors=$((errors + 1))
  fi
done <<< "$SECRETS"

echo ""
if [ "$errors" -eq 0 ]; then
  echo "All secrets synced. New shells will pick them up automatically."
else
  echo "Warning: $errors secret(s) failed. Is 1Password unlocked?"
  exit 1
fi
