#!/usr/bin/env zsh

# You may need to manually set your language environment
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Less recursive by default
export LESS=-FirSwX
export PAGER="less ${LESS}";

export GPG_TTY=$(tty)

# You Should Use
# Plugin: MichaelAquilina/zsh-you-should-use
export YSU_MODE=ALL

# Enable shell history for IEx
# https://hexdocs.pm/iex/IEx.html#module-shell-history
export ERL_AFLAGS="-kernel shell_history enabled"

# Link Phoenix debug page stack traces to VSCode
# https://angelika.me/2020/03/22/link-phoenix-debug-page-stack-trace-to-your-editor
export PLUG_EDITOR="vscode://file/__FILE__:__LINE__"

export CODE=$HOME/code

export EDITOR=nvim
export VEDITOR=code

# https://github.com/x-motemen/ghq#environment-variables
export GHQ_ROOT=$CODE

# elixir-ls
export ELS_INSTALL_PREFIX=$GHQ_ROOT/github.com/elixir-lsp/elixir-ls/release

export VOLTA_FEATURE_PNPM=1

# Prevent Node.js from opening a V8 Inspector debugger on SIGUSR1.
# Without this, any local process can send SIGUSR1 to a Node process,
# connect to the debugger on 127.0.0.1:9229 via Chrome DevTools Protocol,
# take a heap snapshot, and extract all in-memory secrets (API keys, tokens, etc).
# This is especially dangerous with AI coding agents that have shell access.
# https://x.com/badlogicgames/status/2022418575424909670
export NODE_OPTIONS="--disable-sigusr1"

export GITHUB_TOKEN={{ .github_token }}
export GITHUB_AUTH={{ .github_token }}
export GITHUB_PERSONAL_ACCESS_TOKEN={{ .github_token }}
export LINEAR_API_KEY={{ onepasswordRead "op://Employee/LINEAR_API_TOKEN/credential" .onepassword_account }}
export OPENAI_API_KEY={{ onepasswordRead "op://Employee/OpenAI API Key/api key" .onepassword_account }}
export GOOGLE_GENERATIVE_AI_API_KEY={{ onepasswordRead "op://Employee/GOOGLE_GENERATIVE_AI_API_KEY/credential" .onepassword_account }}
export PERCY_TOKEN={{ onepasswordRead "op://Employee/PERCY_TOKEN/token" .onepassword_account }}
export HF_TOKEN={{ onepasswordRead "op://Employee/HF_TOKEN/token" .onepassword_account }}

# Secrets loaded at shell runtime via 1Password CLI (not at chezmoi apply time)
# This keeps secrets off disk in plaintext
# export GITHUB_TOKEN=$(op read "op://Personal/GITHUB_TOKEN PAT/token" --account {{ .onepassword_account }})
# export GITHUB_AUTH=$GITHUB_TOKEN
# export OPENAI_API_KEY=$(op read "op://Personal/OpenAI API Key - nvim/api key" --account {{ .onepassword_account }})
# export PERCY_TOKEN=$(op read "op://Personal/PERCY_TOKEN/token" --account {{ .onepassword_account }})


{{- $jj := or (lookPath "/opt/homebrew/bin/jj") (lookPath "/usr/local/bin/jj") }}
{{ if $jj -}}
export JJ_CONFIG=$XDG_CONFIG_HOME/jj/config.toml
{{- end }}

# ncurses
# ensures we use latest ncurses installed through brew
export LDFLAGS="${LDFLAGS} -L/opt/homebrew/opt/ncurses/lib -L/opt/homebrew/opt/curl/lib"
export CPPFLAGS="${CPPFLAGS} -I/opt/homebrew/opt/ncurses/include -I/opt/homebrew/opt/curl/include"

{{- if .smile }}
export AWS_VAULT_KEYCHAIN_NAME=login
{{- end -}}

{{/* vim: set filetype=zsh: */}}
