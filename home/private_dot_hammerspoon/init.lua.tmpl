hs.window.animationDuration = 0 -- disable animations

-- Use `open -b` instead of hs.application.launchOrFocusByBundleID to avoid
-- AX API timeouts when background processes are unresponsive (see: hammerspoon#3450)
function launchOrFocus(bundleID)
  return function()
    hs.execute('open -b ' .. bundleID)
  end
end

-- Store hotkeys globally to prevent Lua garbage collection from disabling them
Hotkeys = {}

local bindings = {
  -- Find bundle ID using
  -- osascript -e 'id of app "Google Chrome"'
  [{'alt', 'cmd', 'ctrl', 'shift'}] = {
    a = launchOrFocus('company.thebrowser.Browser'),
    b = launchOrFocus('com.brave.Browser'),
    -- c = launchOrFocus('com.google.Chrome'),
    c = launchOrFocus('com.todesktop.230313mzl4w4u92'),
    d = launchOrFocus('com.hnc.Discord'),
    f = launchOrFocus('com.apple.finder'),
    g = launchOrFocus('ru.keepcoder.Telegram'),
    l = launchOrFocus('com.linear'),
    m = launchOrFocus('com.spotify.client'),
    o = launchOrFocus('md.obsidian'),
    s = launchOrFocus('com.tinyspeck.slackmacgap'),
    t = launchOrFocus('com.mitchellh.ghostty'),
    v = launchOrFocus('com.microsoft.VSCode'),
    w = launchOrFocus('net.whatsapp.Whatsapp'),
    y = launchOrFocus('com.apple.systempreferences'),
    z = launchOrFocus('dev.zed.Zed'),
  },
}

for modifier, keyActions in pairs(bindings) do
  for key, action in pairs(keyActions) do
    table.insert(Hotkeys, hs.hotkey.bind(modifier, tostring(key), action))
  end
end

