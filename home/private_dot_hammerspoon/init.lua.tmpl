require("hs.ipc")

-- Install hs command line tool
{{- if eq .chezmoi.arch "arm64" }}
-- Hammerspoon will fail on newer M1's because it defaults to installing to /usr/local/bin, so we overwrite the path
hs.ipc.cliInstall("/opt/homebrew")
{{ else }}
hs.ipc.cliInstall()
{{- end }}

