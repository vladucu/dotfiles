{{ $zoxide := or (lookPath "/opt/homebrew/bin/zoxide") (lookPath "/usr/local/bin/zoxide") -}}
{{ if $zoxide -}}
# Source zoxide 
{{   output $zoxide "init" "zsh" | trim }}
{{- end }}

{{ $direnv := or (lookPath "/opt/homebrew/bin/direnv") (lookPath "/usr/local/bin/direnv") -}}
{{ if $direnv -}}
# Source direnv
{{   output $direnv "hook" "zsh" | trim }}
{{- end }}

{{ $thefuck := or (lookPath "/opt/homebrew/bin/thefuck") (lookPath "/usr/local/bin/thefuck") -}}
{{ if $thefuck -}}
# Fuck
# https://github.com/nvbn/thefuck
{{   output $thefuck "--alias" | trim }}
{{- end }}


{{ $mise := or (lookPath "/opt/homebrew/bin/mise") (lookPath "/usr/local/bin/mise") -}}
{{ if $mise -}}
# Mise
# https://mise.jdx.dev/
{{   output $mise "activate" "zsh" | trim }}

# There's an issue with `mise` which overwrites the PATH and this is removed from local/share/shell/path.zsh.tmpl.
# For now, adding manually after mise to fix this.
path+=$HOME/.cache/.bun/bin
{{- end }}

ulimit -S -n 65536
ulimit -H -n 200000

{{ end -}}


{{/* vim: set filetype=zsh: */}}
