#!/bin/bash
# Clone agent-config and hand off to its setup, which owns every link
set -eufo pipefail

{{ template "utils" }}

title "[40 - Agent Config - Setup]"

REPO_PATH=$(ghq list -p -e vladucu/agent-config 2>/dev/null || true)
if [ -z "$REPO_PATH" ]; then
  ghq get vladucu/agent-config
  REPO_PATH=$(ghq list -p -e vladucu/agent-config)
fi

"$REPO_PATH/setup" --host all

success "agent-config setup done"
