#!/bin/bash
# Clone agent-config repo and wire symlinks for Pi + Claude Code
set -eufo pipefail

{{ template "utils" }}

title "[40 - Agent Config - Setup]"

# Clone agent-config if needed
REPO_PATH=$(ghq list -p -e vladucu/agent-config 2>/dev/null || true)
if [ -z "$REPO_PATH" ]; then
  ghq get vladucu/agent-config
  REPO_PATH=$(ghq list -p -e vladucu/agent-config)
fi

echo "Using agent-config at: $REPO_PATH"

# Create directories
mkdir -p ~/.claude/skills ~/.claude/hooks ~/.claude/commands ~/.pi/agent

# Skills symlinks
for skill in smile-io-dev jj manage-linear pr-creator resolve-dependabot-alerts skill-crafting tmux; do
  ln -sfn "$REPO_PATH/skills/$skill" "$HOME/.claude/skills/$skill"
done

# Claude config symlinks
ln -sfn "$REPO_PATH/claude/settings.json" "$HOME/.claude/settings.json"
ln -sfn "$REPO_PATH/claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
ln -sfn "$REPO_PATH/claude/hooks/notify.sh" "$HOME/.claude/hooks/notify.sh"
ln -sfn "$REPO_PATH/claude/commands/resume.md" "$HOME/.claude/commands/resume.md"
ln -sfn "$REPO_PATH/claude/commands/save-progress.md" "$HOME/.claude/commands/save-progress.md"
ln -sfn "$REPO_PATH/claude/commands/cl" "$HOME/.claude/commands/cl"
ln -sfn "$REPO_PATH/claude/statusline-command.sh" "$HOME/.claude/statusline-command.sh"

# Pi config
ln -sfn "$REPO_PATH/pi/settings.json" "$HOME/.pi/agent/settings.json"

success "Agent config symlinks created!"
